# Template for signing release APK / Android App Bundle (.aab)
# Generate your keystore with:
# keytool -genkey -v -keystore noin-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias noin
#
# Store credentials in keystore.properties (keep out of git):
storeFile=../noin-release.jks
storePassword=YourStorePasswordHere
keyAlias=noin
keyPassword=YourKeyPasswordHere
